{
  "name": "gw2cc",
  "productName": "GW2CC",
  "desktopName": "com.gw2cc.desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Guild Wars 2 Character Console",
  "main": "out/main/main.js",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run rebuild && electron-vite dev",
    "dev:fixture": "npm run rebuild && cross-env GW2CC_FIXTURE_MODE=1 electron-vite dev",
    "build": "electron-vite build",
    "package": "npm run build && electron-builder --dir --config electron-builder.yml",
    "dist": "npm run build && electron-builder --config electron-builder.yml",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "npm rebuild better-sqlite3 && vitest run",
    "test:watch": "npm rebuild better-sqlite3 && vitest",
    "test:e2e": "npm run rebuild && cross-env GW2CC_FIXTURE_MODE=1 playwright test",
    "rebuild": "electron-rebuild --force --only better-sqlite3"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.0",
    "better-sqlite3": "^12.2.0",
    "dompurify": "^3.3.1",
    "marked": "^15.0.12",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "undici": "^6.28.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.1",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "cross-env": "^10.0.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^4.0.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.20.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
