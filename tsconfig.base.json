{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "vitest/globals", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "@gw2cc/core": ["packages/core/src/index.ts"],
      "@gw2cc/gw2": ["packages/gw2/src/index.ts"],
      "@gw2cc/llm": ["packages/llm/src/index.ts"],
      "@gw2cc/protocol": ["packages/protocol/src/index.ts"],
      "@gw2cc/storage": ["packages/storage/src/index.ts"],
      "@gw2cc/tools": ["packages/tools/src/index.ts"],
      "@gw2cc/web": ["packages/web/src/index.ts"]
    }
  }
}
